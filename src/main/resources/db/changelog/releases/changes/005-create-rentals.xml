<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260114-3" author="mateusz kmiec">
        <createTable tableName="rentals">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="item_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_rentals_item" referencedTableName="items" referencedColumnNames="id"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_rentals_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="start_date_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="end_date_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="return_date_time" type="TIMESTAMP"/>
            <column name="total_cost" type="DECIMAL(10,2)"/>
            <column name="deposit" type="DECIMAL(10,2)"/>
            <column name="deposit_paid" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_method" type="VARCHAR(20)"/>
            <column name="payment_method" type="VARCHAR(20)"/>
            <column name="shipping_cost" type="DECIMAL(10,2)"/>
            <column name="invoice_requested" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="hand_over_notes" type="VARCHAR(1024)"/>
            <column name="return_notes" type="VARCHAR(1024)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>
</databaseChangeLog>