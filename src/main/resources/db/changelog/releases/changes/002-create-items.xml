<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260114-1" author="mateusz kmiec">
        <createTable tableName="items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sku" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="title" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(5000)">
                <constraints nullable="false"/>
            </column>
            <column name="price_per_day" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="discounted_percent" type="INT"/>
            <column name="deposit" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="deposit_price" type="DECIMAL(10,2)"/>
            <column name="image_url" type="VARCHAR(1024)"/>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_items_category"
                             referencedTableName="categories"
                             referencedColumnNames="id"/>
            </column>
            <column name="average_rating" type="DOUBLE"/>
            <column name="review_count" type="INT" defaultValueNumeric="0"/>
            <column name="available" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="can_be_shipped" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="can_be_picked_up" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="shipping_price" type="DECIMAL(10,2)"/>
            <column name="min_rental_days" type="INT" defaultValueNumeric="1"/>
            <column name="is_new" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="last_modified" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>